# Secrets — never commit real keys
.env

# Dependencies / junk
node_modules/
*.log
.DS_Store

# Review artifacts — regenerable via `node tools/shots.mjs`
/shots/

# Dream loop working files (targets, captures, judge verdicts) — builder
# evidence only, never committed, never in a critic packet
/.dream-loop/

# Scratch analysis scripts and crops from review agents
/_*.mjs
/_crops/

# Reference imagery — art-direction only, never redistributed, never committed
/refs/

# Authored-asset pipeline: raw generations are large; assets/models/ holds the prepared GLBs
/assets-raw/
/pipeline/object_info.json
/pipeline/__pycache__/
